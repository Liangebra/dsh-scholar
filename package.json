{
  "name": "dsh-scholar",
  "version": "0.1.0",
  "description": "Research/scholar tool suite for DeepSeek Harness: arXiv search, paper fetch (HTML/PDF, optional proxy), and OpenAlex journal lookup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/202411130091-coder/dsh-scholar.git"
  },
  "homepage": "https://github.com/202411130091-coder/dsh-scholar#readme",
  "bugs": {
    "url": "https://github.com/202411130091-coder/dsh-scholar/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "arxiv",
    "openalex",
    "pdf",
    "research"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^6.19.0",
    "unpdf": "^1.8.1"
  }
}
